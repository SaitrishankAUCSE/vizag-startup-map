  "text": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Mediklaud</title>\n    <script>\nfunction updateFontSize() {\n  const vw = window.innerWidth * 0.01;\n  document.documentElement.style.fontSize = `${vw}px`;\n}\nwindow.addEventListener('load', updateFontSize);\nwindow.addEventListener('resize', updateFontSize);\n</script>\n\n        <script>\n  function getActualViewportWidth() {\n    return window.visualViewport ? window.visualViewport.width : window.innerWidth;\n  }\n\n  function checkViewportAndRedirect() {\n    const actualWidth = getActualViewportWidth();\n\n    if (actualWidth <= 390 && !window.location.href.includes('index-mobile.html')) {\n      window.location.href = \"index-mobile.html\";\n    }\n\n    if (actualWidth > 390 && window.location.href.includes('index-mobile.html')) {\n      window.location.href = \"index.html\";\n    }\n  }\n\n  window.addEventListener('resize', checkViewportAndRedirect);\n  window.addEventListener('load', checkViewportAndRedirect);\n</script>\n\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap\" rel=\"stylesheet\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@1,300&display=swap\" rel=\"stylesheet\">\n</head>\n    <body>\n        <div class=\"main-wrapper\">\n            <div class=\"navbar\">\n                <div class=\"logo\">\n                    <img src=\"/assets/Logo.svg\" alt=\"\">\n                </div>\n                <div class=\"links-wrapper\">\n                    <a href=\"\">\n                        ECOSISTEMA\n                    </a>\n                    <a href=\"\">\n                        SERVICIOS\n                    </a>\n                    <a href=\"\">\n                        PRECIOS\n                    </a>\n                    <a href=\"\">\n                        NOSOTROS\n                    </a>\n                </div>\n                <div class=\"solo-link-wrapper\">\n                    <a href=\"\">\n                        COMIENZA<br>AHORA\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero\">\n                <div class=\"img-wrapper\">\n                    <img src=\"/assets/doctorsHEROs.webp\" alt=\"\">\n                </div>\n                <div class=\"text1\">\n                        <p>EJERCE<br>SIN<br>LIMITES</p>\n                    </div>\n                    <div class=\"text2\">\n                        <p>\n                            redefine tu práctica.<br>decide con claridad.<br>avanza con precisión.\n                        </p>\n                    </div>\n            </div>\n            <div class=\"valueProp\">\n                <div class=\"navbar-sensor\"></div>\n                <div class=\"triangle\"></div>\n                <div class=\"content\"></div>\n                <div class=\"text1\">\n                    <p>\n                        Libera el potencial<br>de tu práctica profesional\n                    </p>\n                </div>\n                <div class=\"text2\">\n                    <p>\n                        con el ecosistema digital de mediKlaud\n                    </p>\n                </div>\n                <div class=\"text3\">\n                    <p>\n                        Listo para integrarse desde el primer clic: historiales clínicos centralizados,<br>\n                        consultas remotas seguras y gestión de citas sin fricciones.<br>\n                        <span>Sin configuraciones complejas ni curva de aprendizaje.</span>\n                    </p>\n                </div>\n                <div class=\"imgcontainer\">\n                    <img src=\"/assets/valueProposition_app.webp\" alt=\"\">\n                </div>\n            </div>\n            <div class=\"Section03\">\n                <div class=\"imgcontainer1\">\n                    <img src=\"/assets/98Hr.webp\" alt=\"\">\n                </div>\n                <div class=\"text1 scroll-fade-sec03\">\n                    <p>\n                        98 horas al mes.<br>\n                        Ese es el tiempo que pierden<br>\n                        los profesionales de la salud en México<br>\n                        en tareas que no curan, no aportan<br>\n                        y no se cobran.<br>\n                    </p>\n                </div>\n                <div class=\"text2\">\n                    <p>\n                        mediKlaud recupera tu tiempo.\n                    </p>\n                </div>\n                <div class=\"text3\">\n                    <p>\n                        Convierte esas horas perdidas en consultas,<br>\n                        aprendizaje, reputación, descanso o<br>\n                        crecimiento financiero.\n                    </p>\n                </div>\n                <div class=\"imgcontainer2\">\n                    <img src=\"/assets/section03Doctor.webp\" alt=\"\">\n                </div>\n            </div>\n            <div class=\"toolShowcase\">\n                <div class=\"navbar-sensor\"></div>\n                <div class=\"tool-scroller\">\n                    <div class=\"tool-scroller-track\">\n                        <p>anamnesisPRO</p>\n                        <p>consultaPRO</p>\n                        <p>finanzasPRO</p>\n                        <p>bienestarPRO</p>\n                        <p>carteraPRO</p>\n\n                        <!-- Duplicados para loop infinito -->\n                        <p>anamnesisPRO</p>\n                        <p>consultaPRO</p>\n                        <p>finanzasPRO</p>\n                        <p>bienestarPRO</p>\n                        <p>carteraPRO</p>\n                    </div>\n                </div>\n                <div class=\"fade1\"></div>\n                <div class=\"fade2\"></div>\n                <div class=\"fade3\"></div>\n                <div class=\"fade4\"></div>\n                <div class=\"fade5\"></div>\n                <div class=\"fade6\"></div>\n                <div class=\"fade7\"></div>\n                <div class=\"fade8\"></div>\n                <div class=\"fade9\"></div>\n                <div class=\"hero-text1\">\n                    <p>\n                        Descubre las herramientas\n                    </p>\n                </div>\n                <div class=\"hero-text2\">\n                    <p>\n                        que necesitas para tomar el control<br>de tu práctica profesional.\n                    </p>\n                </div>\n                <div class=\"consultaPro-wrapper\">\n                    <div class=\"consulta-text1\">\n                        <p>\n                            consultaPRO\n                        </p>\n                    </div>\n                    <div class=\"consulta-text2\">\n                        <p>\n                            DOMINA TODA DECISIÓN MÉDICA\n                        </p>\n                    </div>\n                    <div class=\"consulta-text3\">\n                        <p>\n                            Herramientas clínicas para una\n                            mejor conexión con tus pacientes  \n                        </p>\n                    </div>\n                    <div class=\"consulta-text4\">\n                        <p>\n                            Potencia tu consulta desde la primera pregunta\n                        </p>\n                    </div>\n                </div>\n                <div class=\"consulta-imgWerapper\">\n                    <img src=\"/assets/valueBox_consultaPRO.svg\" alt=\"\">\n                </div>\n                <div class=\"cartera-imgWerapper\">\n                    <img src=\"/assets/valueBox_carteraPRO.svg\" alt=\"\">\n                </div>\n                <div class=\"acertera-textWrapper\">\n                    <div class=\"acertera-text1\">\n                        <p>\n                            carteraPRO\n                        </p>\n                    </div>\n                    <div class=\"acertera-text2\">\n                        <p>\n                            CONTROL TOTAL DE TUS FINANZAS\n                        </p>\n                    </div>\n                    <div class=\"acertera-text3\">\n                        <p>\n                            Analiza tus ingresos, detecta fugas,<br>\n                            gestiona eficientemente tus recursos\n                        </p>\n                    </div>\n                    <div class=\"acertera-text4\">\n                        <p>\n                            Incrementa tu rentabilidad sin complicaciones\n                        </p>\n                    </div>\n                </div>\n                <div class=\"marca-textWrapper\">\n                    <div class=\"marca-text1\">\n                    <p>\n                        marcaPRO\n                    </p>\n                    </div>\n                    <div class=\"marca-text2\">\n                        <p>\n                            TU REPUTACION NO SE IMPROVISA\n                        </p>\n                    </div>\n                    <div class=\"marca-text3\">\n                        <p>\n                            Constrúyela con inteligencia, estrategia y<br>\n                            presencia profesional \n                        </p>\n                    </div>\n                    <div class=\"marca-text4\">\n                        <p>\n                            Haz que tu experiencia tenga voz\n                        </p>\n                    </div>\n                </div>\n                <div class=\"marca-imgWerapper\">\n                    <img src=\"/assets/valueBox_marcaPRO.svg\" alt=\"\">\n                </div>\n                <div class=\"formacion-imgWerapper\">\n                    <img src=\"/assets/valueBox_formacionPRO.svg\" alt=\"\">\n                </div>\n                <div class=\"formacion-textWrapper\">\n                    <div class=\"formacion-text1\">\n                    <p>\n                        formaciónPRO\n                    </p>\n                    </div>\n                    <div class=\"formacion-text2\">\n                        <p>\n                            ACTUALIZATE. CERTIFICATE. AVANZA.\n                        </p>\n                    </div>\n                    <div class=\"formacion-text3\">\n                        <p>\n                            Accede a programas de educación continua,<br>\n                            alineados a tu ritmo profesional.\n                        </p>\n                    </div>\n                    <div class=\"formacion-text4\">\n                        <p>\n                            Potencia tu carrera todos los días.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"eco-text1\">\n                    <p>\n                        Un ecosistema en expansión donde tu participación impulsa el cambio\n                    </p>\n                </div>\n                <div class=\"eco-text2\">\n                    <p>\n                        Comparte, aprende y contribuye para acceder a herramientas cada vez más poderosas.<br>\n                        <span>Sin costos, sin plazos, sin sorpresas.</span>\n                    </p>\n                </div>\n                <div class=\"bullet1-icon\">\n                    <img src=\"/assets/tA_Disponible.svg\" alt=\"\">\n                </div>\n                <div class=\"bullet1-text1\">\n                    <p>\n                        DISPONIBLE\n                    </p>\n                </div>\n                <div class=\"bullet1-text2\">\n                    <p>\n                        Esta herramienta está lista para usarse.\n                    </p>\n                </div>\n                <div class=\"bullet2-icon\">\n                    <img src=\"/assets/tA_Desbloqueada.svg\" alt=\"\">\n                </div>\n                <div class=\"bullet2-text1\">\n                    <p>\n                        DESBLOQUEADA\n                    </p>\n                </div>\n                <div class=\"bullet2-text2\">\n                    <p>\n                        ¡Has ganado acceso!<br>\n                        Ahora puedes aprovechar esta herramienta.\n                    </p>\n                </div>\n                <div class=\"bullet3-icon\">\n                    <img src=\"/assets/tA_Pendiente.svg\" alt=\"\">\n                </div>\n                <div class=\"bullet3-text1\">\n                    <p>\n                        PENDIENTE\n                    </p>\n                </div>\n                <div class=\"bullet3-text2\">\n                    <p>\n                        Estás a pocos pasos de liberar esta herramienta.\n                    </p>\n                </div>\n                <div class=\"group01-wrapper\">\n                    <img src=\"/assets/aT_Group01.svg\" alt=\"\">\n                </div>\n                <div class=\"group02-wrapper\">\n                    <img src=\"/assets/aT_Group02.svg\" alt=\"\">\n                </div>\n                <div class=\"quotes-wrapper\">\n                    <img src=\"/assets/testimonial_ComillaDecorativa.svg\" alt=\"\">\n                </div>\n                <div class=\"testimonys-wrapper\">\n                    <div class=\"testimony-1\">\n                        <p class=\"animated\">\n                        “<span>Con tanto que</span> hacer en consulta, lo último que necesito es <span>algo complicado.</span> mediKlaud me <span>resolvió más</span> de lo que esperaba, <span>sin pedirme nada</span> extraño.”\n                        </p>\n                    </div>\n                    <div class=\"testimony-2\">\n                        <p>Especialista en medicina interna, CDMX</p>\n                    </div>\n                    </div>\n                    <div class=\"start-wrapper\">\n                        <p>\n                            inicia tu<br>experiencia\n                        </p>\n                    </div>\n                </div>\n            <div class=\"gaceta\">\n                <div class=\"compu-imgwrapper scroll-fade-gaceta\">\n                    <img src=\"/assets/gC_mockUpScreen.webp\" alt=\"\">\n                </div>\n                <div class=\"text1\">\n                    <p>\n                        La gaceta mediklaud es la puerta de entrada al ecosistema. Expande tu conocimiento y lleva tu práctica médica al siguiente nivel.\n                    </p>\n                </div>\n                <div class=\"text2\">\n                    <a href=\"\">\n                        <p>\n                            COMIENZA<br>AHORA\n                        </p>\n                    </a>\n                </div>\n                <div class=\"background\"></div>\n            </div>\n            <div class=\"footer\">\n                <div class=\"navbar-sensor\"></div>\n                <div class=\"text1\">\n                    <p>\n                        la solución digital<br>más poderosa,<br>que transformará tu<br>práctica profesional.\n                    </p>\n                </div>\n                <div class=\"text2\">\n                    <p>\n                        Empieza a transformar tu practica hoy.\n                    </p>\n                </div>\n                <div class=\"compania-wrapper\">\n                    <p>\n                        Compañía\n                    </p>\n                </div>\n                <div class=\"compania-links-wrapper\">\n                    <a href=\"\">quiénes somos</a>\n                    <a href=\"\">nuestro compromiso</a>\n                    <a href=\"\">prensa</a>\n                    <a href=\"\">contacto</a>\n                </div>\n                <div class=\"servicios-wrapper\">\n                    <p>\n                        Servicios\n                    </p>\n                </div>\n                <div class=\"servicios-links-wrapper\">\n                    <a href=\"\">consultaPRO</a>\n                    <a href=\"\">carteraPRO</a>\n                    <a href=\"\">marcaPRO</a>\n                    <a href=\"\">formaciónPRO</a>\n                    <a href=\"\">soporteLEGAL</a>\n                    <a href=\"\">rankingPRO</a>\n                    <a href=\"\">bienestarPRO</a>\n                </div>\n                <div class=\"recursos-wrapper\">\n                    <p>\n                        Recursos\n                    </p>\n                </div>\n                <div class=\"recursos-links-wrapper\">\n                    <a href=\"\">centro de ayuda</a>\n                    <a href=\"\">preguntas frecuentes</a>\n                    <a href=\"\">blog/gaceta médica</a>\n                    <a href=\"\">manual del usuario</a>\n                </div>\n                <div class=\"line\"></div>\n                <div class=\"logo-wrapper\">\n                    <img src=\"/assets/Footer_logo.svg\" alt=\"\">\n                </div>\n                <div class=\"text3\">\n                    <p>\n                        © 2025 mediKlaud.<br>\n                        Todos los derechos reservados.<br>\n                        Aviso de privacidad | Términos y condiciones<br>\n                        Hecho en México\n                    </p>\n                </div>\n                <div class=\"in-wrapper\">\n                    <a href=\"\">\n                        <img src=\"/assets/Footer_LinkedInLogo.png\" alt=\"\">\n                    </a>\n                </div>\n                <div class=\"ig-wrapper\">\n                    <a href=\"\">\n                        <img src=\"/assets/Footer_InstagramLogo.svg\" alt=\"\">\n                    </a>\n                </div>\n            </div>\n        </div>\n        <script>\n            // Aplica el efecto scroll-fade a los elementos padre de cada renglón\nconst observer = new IntersectionObserver(\n  entries => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('active');\n      } else {\n        entry.target.classList.remove('active');\n      }\n    });\n  },\n  {\n    threshold: 0.3\n  }\n);\n\n// Lista de wrappers para cada renglón\nconst fadeGroups = [\n  ['.consultaPro-wrapper', '.consulta-imgWerapper'],\n  ['.acertera-textWrapper', '.cartera-imgWerapper'],\n  ['.marca-textWrapper', '.marca-imgWerapper'],\n  ['.formacion-textWrapper', '.formacion-imgWerapper']\n];\n\n// Agrega la clase scroll-fade a los elementos y los observa\nfadeGroups.forEach(group => {\n  group.forEach(selector => {\n    const el = document.querySelector(selector);\n    if (el) {\n      el.classList.add('scroll-fade');\n      observer.observe(el);\n    }\n  });\n});\n\n        </script>\n\n<script>\n  function toggleFadeSec03OnScroll() {\n    const elements = document.querySelectorAll('.scroll-fade-sec03');\n    const triggerBottom = window.innerHeight * 0.9;\n\n    elements.forEach(el => {\n      const boxTop = el.getBoundingClientRect().top;\n\n      if (boxTop < triggerBottom) {\n        el.classList.add('active');\n      } else {\n        el.classList.remove('active');\n      }\n    });\n  }\n\n  window.addEventListener('scroll', toggleFadeSec03OnScroll);\n  window.addEventListener('load', toggleFadeSec03OnScroll);\n</script>\n<script>\n  const observerGaceta = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      entry.target.classList.toggle(\"active\", entry.isIntersecting);\n    });\n  }, {\n    threshold: 0.2\n  });\n\n  document.querySelectorAll(\".scroll-fade-gaceta\").forEach(el => observerGaceta.observe(el));\n</script>\n<script>\n  window.addEventListener(\"scroll\", () => {\n    const quote = document.querySelector(\".quotes-text1\");\n    const triggerPoint = window.innerHeight * 0.8;\n\n    if (quote.getBoundingClientRect().top < triggerPoint) {\n      quote.classList.add(\"animate\");\n    } else {\n      quote.classList.remove(\"animate\"); // reversible\n    }\n  });\n</script>\n<script>\n  const quotes = [\n    {\n      text: `“Con tanto que <span>hacer en consulta,</span> lo último que necesito es <span>algo complicado.</span> mediKlaud me <span>resolvió más</span> de lo que esperaba, <span>sin pedirme nada</span> extraño.”`,\n      author: \"Especialista en medicina interna, CDMX\"\n    },\n    {\n      text: `“La mayoría de las plataformas médicas que probé<br>\n  eran <span>frías, impersonales o confusas.</span><br>\n  mediKlaud me <span>entendió desde el primer clic.</span>”`,\n      author: \"Ginecóloga privada, Monterrey\"\n    },\n    {\n      text: `“Me <span>sorprendió</span> que una plataforma<br>\n  digital me <span>ayudara a mejorar</span><br>\n  tanto mi perfil profesional como mi consulta presencial.”`,\n      author: \"Médico general, Guadalajara\"\n    },\n    {\n      text: `“mediKlaud no solo <span>te da herramientas,</span><br>\n  te <span>enseña a usarlas.</span><br>\n  Me sentí <span>acompañada desde el primer día.</span>”`,\n      author: \"Psicóloga clínica, Cuernavaca\"\n    }\n  ];\n\n  let index = 0;\n  const pText = document.querySelector(\".testimony-1 p\");\n  const pAuthor = document.querySelector(\".testimony-2 p\");\n\n  function updateTestimony() {\n    // Apagar animación\n    pText.classList.remove(\"animated\");\n    pText.classList.add(\"fade-out\");\n    pAuthor.classList.add(\"fade-out\");\n\n    setTimeout(() => {\n      // Cambiar texto\n      pText.innerHTML = quotes[index].text;\n      pAuthor.textContent = quotes[index].author;\n\n      // Reiniciar animación\n      pText.classList.remove(\"fade-out\");\n      pAuthor.classList.remove(\"fade-out\");\n\n      requestAnimationFrame(() => {\n        pText.classList.add(\"animated\");\n      });\n\n      index = (index + 1) % quotes.length;\n    }, 400); // Delay para hacer transición visual\n  }\n\n  // Iniciar animación\n  pText.classList.add(\"animated\");\n  setInterval(updateTestimony, 6000);\n</script>\n<script>\nconst navbar = document.querySelector('.navbar');\nlet lastScrollY = window.scrollY;\n\n// Scroll hide/show logic\nwindow.addEventListener('scroll', () => {\n  const currentScrollY = window.scrollY;\n\n  if (currentScrollY > lastScrollY && currentScrollY > 50) {\n    navbar.classList.add('navbar--hidden');\n    navbar.classList.remove('navbar--show-fixed');\n  } else if (currentScrollY < lastScrollY) {\n    navbar.classList.remove('navbar--hidden');\n    navbar.classList.add('navbar--show-fixed');\n  }\n\n  // Reset fixed state at top\n  if (currentScrollY <= 10) {\n    navbar.classList.remove('navbar--show-fixed');\n  }\n\n  lastScrollY = currentScrollY;\n});\n</script>\n\n<script>\n  window.addEventListener('scroll', () => {\n    if (window.scrollY > 10) {\n      navbar.classList.add('navbar--glass');\n    } else {\n      navbar.classList.remove('navbar--glass');\n    }\n  });\n\n  // Aseguramos que se aplique correctamente al recargar arriba o haciendo reload en scroll\n  window.addEventListener('load', () => {\n    if (window.scrollY > 10) {\n      navbar.classList.add('navbar--glass');\n    }\n  });\n</script>\n\n\n<script>\n  const darkSections = ['.valueProp', '.toolShowcase', '.footer'];\n  const activeDarkSections = new Set();\n\n  const colorObserver = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      const section = entry.target;\n      if (entry.isIntersecting) {\n        activeDarkSections.add(section);\n      } else {\n        activeDarkSections.delete(section);\n      }\n    });\n\n    // ✅ CORRECTO: fondo claro = aplicar navbar--dark para texto oscuro\n    if (activeDarkSections.size === 0) {\n      navbar.classList.add('navbar--dark'); // fondo claro → texto oscuro\n    } else {\n      navbar.classList.remove('navbar--dark'); // fondo oscuro → texto claro\n    }\n  }, {\n    threshold: 0.01\n  });\n\n  darkSections.forEach(selector => {\n    const el = document.querySelector(selector);\n    if (el) {\n      const sensor = document.createElement('div');\n      sensor.classList.add('navbar-sensor');\n      el.prepend(sensor);\n      colorObserver.observe(sensor);\n    }\n  });\n</script>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    </body>\n<script>'undefined'=== typeof _trfq || (window._trfq = []);'undefined'=== typeof _trfd && (window._trfd=[]),_trfd.push({'tccl.baseHost':'secureserver.net'},{'ap':'cpbh-mt'},{'server':'p3plmcpnl508439'},{'dcenter':'p3'},{'cp_id':'10155734'},{'cp_cl':'8'}) // Monitoring performance to make your website faster. If you want to opt-out, please contact web hosting support.</script><script src='https://img1.wsimg.com/traffic-assets/js/tccl.min.js'></script></html>",
  "contentType": "text/html",
