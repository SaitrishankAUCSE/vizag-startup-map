</script>\n  <link rel=\"stylesheet\" crossorigin=\"\" href=\"/assets/index-BCyfd--J.css\">\n<title>About Us | Dentic World</title><meta name=\"description\" content=\"Learn about Dentic World's mission to advance dental innovation, research, and clinical excellence from India's first Dental Innovation &amp; Technology Hub at AMTZ.\"><meta name=\"robots\" content=\"index, follow\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:title\" content=\"About Us | Dentic World\"><meta property=\"og:description\" content=\"Learn about Dentic World's mission to advance dental innovation, research, and clinical excellence from India's first Dental Innovation &amp; Technology Hub at AMTZ.\"><meta property=\"og:url\" content=\"https://www.denticworld.com/about\"><meta property=\"og:image\" content=\"https://www.denticworld.com/Dentic/logos/dw-logo-bg.jpg\"><meta property=\"og:site_name\" content=\"Dentic World\"><meta name=\"twitter:card\" content=\"summary_large_image\"><meta name=\"twitter:title\" content=\"About Us | Dentic World\"><meta name=\"twitter:description\" content=\"Learn about Dentic World's mission to advance dental innovation, research, and clinical excellence from India's first Dental Innovation &amp; Technology Hub at AMTZ.\"><meta name=\"twitter:image\" content=\"https://www.denticworld.com/Dentic/logos/dw-logo-bg.jpg\"><link rel=\"canonical\" href=\"https://www.denticworld.com/about\"></head>\n\n<body>\n  <!-- Google Tag Manager (noscript) -->\n  <noscript><iframe src=\"https://www.googletagmanager.com/ns.html?id=GTM-NQZ893HN\"\n  height=\"0\" width=\"0\" style=\"display:none;visibility:hidden\"></iframe></noscript>\n  <!-- End Google Tag Manager (noscript) -->\n\n  <div id=\"root\"><div class=\"d-flex flex-column min-vh-100\" style=\"background-color: var(--color-clean-white);\"><div class=\"site-wrapper d-flex flex-column min-vh-100\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Dentic World\",\"url\":\"https://www.denticworld.com\",\"logo\":\"https://www.denticworld.com/Dentic/logos/dw-logo.png\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"04th Floor, WTC Centre, Medpolis Research Square 4554, AMTZ Campus, Pragati Maidan\",\"addressLocality\":\"Visakhapatnam\",\"addressRegion\":\"Andhra Pradesh\",\"postalCode\":\"530031\",\"addressCountry\":\"IN\"},\"email\":\"info@denticworld.com\",\"telephone\":\"+917672000722\",\"sameAs\":[\"https://www.linkedin.com/company/dentic-world/posts/?feedView=all\",\"https://www.facebook.com/share/18LW9jZVK8/\",\"https://www.instagram.com/denticworld/\",\"https://www.youtube.com/@Dentic_world\"]}</script><header><nav class=\"main-navbar  navbar navbar-expand-lg navbar-light fixed-top\"><div class=\"navbar-container container-fluid\"><a aria-label=\"Dentic World Home\" class=\"brand navbar-brand\" href=\"/\"><img alt=\"Dentic World Logo\" class=\"logo\" src=\"/Dentic/logos/dentic logo final.png\"></a><div class=\"d-flex align-items-center ms-auto d-lg-none\"><button type=\"button\" aria-label=\"Open navigation menu\" class=\"mobile-navbar-toggle\"><span></span><span></span><span></span></button></div><div class=\"d-none d-lg-flex justify-content-end align-items-center navbar-collapse collapse\" id=\"main-navbar\"><div class=\"main-nav align-items-center navbar-nav\"><a class=\"nav-item  nav-link\" href=\"/\">Home</a><a class=\"nav-item active nav-link\" href=\"/about\">About</a><div class=\"nav-dropdown  nav-item dropdown\"><a id=\"services-dropdown\" aria-expanded=\"false\" role=\"button\" class=\"dropdown-toggle nav-link\" tabindex=\"0\" href=\"#\">Services</a></div><a class=\"nav-item  nav-link\" href=\"/facilities\">Facilities</a><a class=\"nav-item  nav-link\" href=\"/partners\">Partners</a><div class=\"nav-dropdown  nav-item dropdown\"><a id=\"media-dropdown\" aria-expanded=\"false\" role=\"button\" class=\"dropdown-toggle nav-link\" tabindex=\"0\" href=\"#\">Media</a></div><a class=\"nav-item  nav-link\" href=\"/contact\">Contact</a><a class=\"nav-item  nav-link\" href=\"/careers\">Careers</a></div><button type=\"button\" class=\"btn-primary schedule-btn ms-lg-4 btn btn-primary\">Schedule Visit</button></div></div></nav></header><div class=\"navbar-spacer\"></div><div class=\"page-body\"><main class=\"flex-grow-1 main-content\"><div class=\"content-container\"><main style=\"flex: 1 1 0%;\"><div class=\"page-container\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.denticworld.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About\",\"item\":\"https://www.denticworld.com/about\"}]}</script><section class=\"about-hero-carousel-section\"><div class=\"about-hero-bg-slide active\" style=\"background-image: url(&quot;/assets/home3-CvI3UWI2.jpg&quot;);\"></div><div class=\"about-hero-overlay\"></div><div class=\"about-hero-content container\"><h1 class=\"about-hero-headline fw-bold mb-4\">Pioneering Dental Innovation in India</h1></div></section><section class=\"about-story-section py-5 bg-white\"><div class=\"container\"><h2 class=\"section-title text-center mb-4\">The Genesis of Dentic World</h2><div class=\"align-items-center g-5 row\"><div class=\"col-lg-6\"><div class=\"about-story-text\"><p class=\"mb-4 body-regular\">Dentic World exists to bridge the gap between dental research and commercial reality — creating an ecosystem where innovation thrives and transforms into tangible solutions that improve oral healthcare globally.</p><p class=\"mb-4 body-regular\">India imports over 90% of its dental technology — a dependency that limits access to affordable oral healthcare and stifles domestic innovation. Dentic World was conceived to address this fundamental challenge.</p><p class=\"mb-4 body-regular\">Our journey began with a simple question: What if India’s brightest dental innovators had access to world-class facilities, expert mentorship, and a clear path to manufacturing — all in one place?</p><p class=\"about-highlight-text  fs-4 mt-4\"> - Dentic World is the answer.</p></div></div><div class=\"col-lg-6\"><div class=\"text-center text-lg-end\"><img alt=\"Dentic World Logo\" class=\"about-story-image img-fluid rounded shadow\" loading=\"lazy\" src=\"/assets/dw-logo-70CWu3j4.png\"></div></div></div></div></section><section class=\"about-vision-mission-section py-5\"><div class=\"container\"><h2 class=\"section-title text-center mb-4\">Vision &amp; Mission</h2><div class=\"g-4 justify-content-center row\"><div class=\"col-md-6\"><div class=\"about-vm-simple-card\"><h3 class=\"about-vm-simple-title\">Our Vision</h3><p class=\"about-vm-simple-desc\">To establish Dentic World as the global benchmark for dental innovation — transforming India from an import-dependent market to a leading exporter of advanced, affordable dental solutions.</p></div></div><div class=\"col-md-6\"><div class=\"about-vm-simple-card\"><h3 class=\"about-vm-simple-title\">Our Mission</h3><p class=\"about-vm-simple-desc\">Dentic World provides world-class infrastructure, expert guidance, and comprehensive ecosystem support to dental innovators, researchers, and manufacturers. We accelerate the journey from concept to commercialization, ensuring breakthrough ideas reach patients who need them.</p></div></div></div></div><div class=\"container\"><div class=\"about-core-values\"><h2 class=\"section-title text-center mb-5\">Our Core Values</h2><ul class=\"about-core-list list-unstyled\"><li class=\"about-core-list-item\">Advance oral healthcare through breakthrough innovation.</li><li class=\"about-core-list-item\">Prioritize patient safety and therapeutic excellence.</li><li class=\"about-core-list-item\">Build strong partnerships through collaboration.</li><li class=\"about-core-list-item\">Deliver quality dental solutions with manufacturing precision.</li></ul></div></div></section><section class=\"about-amtz-section py-5\"><div class=\"container\"><h2 class=\"section-title text-center mb-5\">Powered by AMTZ – Asia’s Largest MedTech Manufacturing Cluster</h2><div class=\"align-items-center g-5 row\"><div class=\"col-lg-6\"><div class=\"text-center text-lg-start\"><img alt=\"AMTZ facility view\" class=\"img-fluid rounded shadow about-amtz-image\" loading=\"lazy\" src=\"/assets/group-CaJEkZoz.png\"><p class=\"mt-3 mb-0 text-center text-lg-start\"><a href=\"https://www.amtz.in/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"about-amtz-link\">amtz.in</a></p></div></div><div class=\"col-lg-6\"><p class=\"about-amtz-text body-regular mb-4\">The Andhra Pradesh MedTech Zone (AMTZ) is a 270-acre integrated manufacturing ecosystem established by the Government of Andhra Pradesh. Home to over 100 medical device companies, AMTZ represents India’s most ambitious effort to build self-reliance in healthcare technology.</p><p class=\"fw-bold mt-4 mb-3\">Dentic World’s location within AMTZ provides:</p><ul class=\"about-amtz-list list-unstyled\"><li>Common Scientific Facilities - Access to BIO-ME (biomaterial testing), ELECTRA (EMI-EMC testing), COBALT (gamma sterilization), and more</li><li>Regulatory Support - Direct pathways to CDSCO certification, with expertise in FDA, CE, and ISO compliance</li><li>Manufacturing Ecosystem - Proximity to precision engineering, electronics manufacturing, and packaging facilities</li><li>Talent Pipeline - Access to skilled workforce through AMTZ’s training programs</li><li>Investment Climate - Government incentives, SEZ benefits, and investor-friendly policies</li></ul></div></div></div></section><section class=\"about-leadership-section py-5\"><div class=\"container\"><h2 class=\"section-title text-center mb-5\">Leadership Team</h2><div class=\"g-4 row\"><div class=\"col-lg-3 col-sm-6 col-12\"><div class=\"leader-card-static bg-white shadow-sm overflow-hidden\"><div class=\"leader-image-wrapper\"><img alt=\"Mr. KRISHNA SAI INKOOLU\" loading=\"lazy\" src=\"/assets/Krishna-DSVhO4wy.jpeg\"></div><div class=\"leader-info-badge\"><h5 class=\"leader-name fw-bold mb-1\">Mr. KRISHNA SAI INKOOLU</h5><p class=\"leader-position mb-0\">CEO</p><p class=\"leader-org mb-0\">Dentic World</p></div></div></div><div class=\"col-lg-3 col-sm-6 col-12\"><div class=\"leader-card-static bg-white shadow-sm overflow-hidden\"><div class=\"leader-image-wrapper\"><img alt=\"Mr. K.R ATCHUTARAO\" loading=\"lazy\" src=\"/assets/atchutrao-DICIgvj3.jpg\"></div><div class=\"leader-info-badge\"><h5 class=\"leader-name fw-bold mb-1\">Mr. K.R ATCHUTARAO</h5><p class=\"leader-position mb-0\">Operations Head</p><p class=\"leader-org mb-0\">Dentic World</p></div></div></div><div class=\"col-lg-3 col-sm-6 col-12\"><div class=\"leader-card-static bg-white shadow-sm overflow-hidden\"><div class=\"leader-image-wrapper\"><img alt=\"Mr. DILEEP KUMAR C\" loading=\"lazy\" src=\"/assets/Dileep-CGZsicM-.jpg\"></div><div class=\"leader-info-badge\"><h5 class=\"leader-name fw-bold mb-1\">Mr. DILEEP KUMAR C</h5><p class=\"leader-position mb-0\">CEO</p><p class=\"leader-org mb-0\">MVIC, AMTZ</p></div></div></div><div class=\"col-lg-3 col-sm-6 col-12\"><div class=\"leader-card-static bg-white shadow-sm overflow-hidden\"><div class=\"leader-image-wrapper\"><img alt=\"Mr. PRATEEK AGARWAL\" loading=\"lazy\" src=\"/assets/Prateek-rX6f6kge.jpg\"></div><div class=\"leader-info-badge\"><h5 class=\"leader-name fw-bold mb-1\">Mr. PRATEEK AGARWAL</h5><p class=\"leader-position mb-0\">TL FINANCIAL SERVICES</p><p class=\"leader-org mb-0\">World Trade Center, AMTZ</p></div></div></div><div class=\"col-lg-3 col-sm-6 col-12\"><div class=\"leader-card-static bg-white shadow-sm overflow-hidden\"><div class=\"leader-image-wrapper\"><img alt=\"Dr. TEJA MAGANTI\" loading=\"lazy\" src=\"/assets/Teja-DMVmUrC9.jpeg\"></div><div class=\"leader-info-badge\"><h5 class=\"leader-name fw-bold mb-1\">Dr. TEJA MAGANTI</h5><p class=\"leader-position mb-0\">CEO</p><p class=\"leader-org mb-0\">MEDI MOLD, AMTZ</p></div></div></div><div class=\"col-lg-3 col-sm-6 col-12\"><div class=\"leader-card-static bg-white shadow-sm overflow-hidden\"><div class=\"leader-image-wrapper\"><img alt=\"Dr. VENKATA SUNDEEP SEESALA \" loading=\"lazy\" src=\"/assets/sundeep-BLc4MDnx.jpeg\"></div><div class=\"leader-info-badge\"><h5 class=\"leader-name fw-bold mb-1\">Dr. VENKATA SUNDEEP SEESALA </h5><p class=\"leader-position mb-0\">Assistant Professor</p><p class=\"leader-org mb-0\">EGIMT, AMTZ</p></div></div></div><div class=\"col-lg-3 col-sm-6 col-12\"><div class=\"leader-card-static bg-white shadow-sm overflow-hidden\"><div class=\"leader-image-wrapper\"><img alt=\"Mr. SANTHOSH B\" loading=\"lazy\" src=\"/assets/s1-arkWkQUw.jpg\"></div><div class=\"leader-info-badge\"><h5 class=\"leader-name fw-bold mb-1\">Mr. SANTHOSH B</h5><p class=\"leader-position mb-0\">CEO</p><p class=\"leader-org mb-0\">Center of Excellence, AMTZ</p></div></div></div></div></div></section></div></main></div></main></div><footer class=\"site-footer\"><div class=\"footer-container container-fluid\"><div class=\"footer-row footer-modern row\"><div class=\"col-lg-3 col-md-6 col-12\"><div class=\"footer-brand-block\"><a class=\"footer-brand\" aria-label=\"Dentic World Home\" href=\"/\"><img alt=\"Dentic World Logo\" class=\"footer-logo\" loading=\"lazy\" src=\"/assets/dw-logo-70CWu3j4.png\"></a><div class=\"social-icons\"><a href=\"https://www.linkedin.com/company/dentic-world/posts/?feedView=all\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\" aria-label=\"LinkedIn\"><i class=\"bi bi-linkedin\"></i></a><a href=\"https://www.facebook.com/share/18LW9jZVK8/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\" aria-label=\"Facebook\"><i class=\"bi bi-facebook\"></i></a><a href=\"https://www.instagram.com/denticworld/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-link\" aria-label=\"Instagram\"><i class=\"bi bi-ins