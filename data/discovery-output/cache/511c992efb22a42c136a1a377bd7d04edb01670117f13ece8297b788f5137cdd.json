dth: 76px;\n      height: 76px;\n      border-radius: 22px;\n      background: linear-gradient(180deg, rgba(255, 158, 36, 0.16) 0%, rgba(255, 158, 36, 0.04) 100%);\n      border: 1px solid rgba(255, 158, 36, 0.35);\n      box-shadow: 0 0 40px rgba(255, 158, 36, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.25);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-bottom: 24px;\n      animation: ksham-pulse 2.4s ease-in-out infinite alternate;\n    }\n\n    .logo-badge img {\n      width: 44px;\n      height: 44px;\n      -o-object-fit: contain;\n         object-fit: contain;\n    }\n\n    .progress-track {\n      width: 200px;\n      height: 3px;\n      background: rgba(255, 255, 255, 0.08);\n      border-radius: 9999px;\n      overflow: hidden;\n      margin-top: 24px;\n      position: relative;\n    }\n\n    .progress-bar {\n      position: absolute;\n      top: 0;\n      bottom: 0;\n      left: -50%;\n      width: 50%;\n      background: linear-gradient(90deg, transparent, #ff9e24, #fbbf24, transparent);\n      border-radius: 9999px;\n      animation: ksham-shimmer 1.4s infinite ease-in-out;\n    }\n\n    @keyframes ksham-pulse {\n      0% {\n        box-shadow: 0 0 25px rgba(255, 158, 36, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.15);\n        transform: scale(0.98);\n      }\n\n      100% {\n        box-shadow: 0 0 45px rgba(255, 158, 36, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.35);\n        transform: scale(1.02);\n      }\n    }\n\n    @keyframes ksham-shimmer {\n      0% {\n        left: -50%;\n      }\n\n      100% {\n        left: 100%;\n      }\n    }\n  </style>\n  <script type=\"module\" crossorigin src=\"/assets/index-Do6AsvLI.js\"></script>\n  <link rel=\"modulepreload\" crossorigin href=\"/assets/vendor-Bp203WpE.js\">\n  <link rel=\"modulepreload\" crossorigin href=\"/assets/pdf-Cng2jlVX.js\">\n  <link rel=\"modulepreload\" crossorigin href=\"/assets/lucide-CE9HbkYi.js\">\n  <link rel=\"modulepreload\" cros