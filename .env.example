# Vizag Startup Map - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.

# -----------------------------------------------------------------
# 1. Supabase (Free tier: https://supabase.com)
# -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------
# 2. Razorpay Subscriptions (https://razorpay.com)
# -----------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret
RAZORPAY_PLAN_PRO_MONTHLY=plan_pro_monthly_id
RAZORPAY_PLAN_PRO_YEARLY=plan_pro_yearly_id
RAZORPAY_PLAN_FEATURED_MONTHLY=plan_featured_monthly_id
RAZORPAY_PLAN_FEATURED_YEARLY=plan_featured_yearly_id

# -----------------------------------------------------------------
# 3. Resend Email (Free tier: https://resend.com)
# -----------------------------------------------------------------
RESEND_API_KEY=re_yourResendApiKey
NOTIFICATION_FROM_EMAIL=alerts@vizagstartupmap.com

# -----------------------------------------------------------------
# 4. App URL & Environment
# -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------
# 5. Map Tile Provider Configuration
# By default, uses OpenStreetMap raster tiles (free, attribution required).
# To swap to MapTiler or Protomaps if traffic grows:
# -----------------------------------------------------------------
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
