# Vizag Startup Map – Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to git.

# -----------------------------------------------------------------
# 1. Firebase Client SDK (safe to expose in browser)
#    Get these from Firebase Console → Project Settings → General → Your apps
# -----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# -----------------------------------------------------------------
# 2. Firebase Admin SDK (server-only — NEVER expose to browser)
#    Create a service account: Firebase Console → Project Settings → Service Accounts
#    Download the JSON key and extract the values below.
# -----------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private key exactly as shown in the JSON file (keep the newlines as \n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------
# 3. Razorpay Subscriptions (https://razorpay.com)
# -----------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret
RAZORPAY_PLAN_PRO_MONTHLY=plan_pro_monthly_id
RAZORPAY_PLAN_PRO_YEARLY=plan_pro_yearly_id
RAZORPAY_PLAN_FEATURED_MONTHLY=plan_featured_monthly_id
RAZORPAY_PLAN_FEATURED_YEARLY=plan_featured_yearly_id

# -----------------------------------------------------------------
# 4. Resend Email (https://resend.com)
# -----------------------------------------------------------------
RESEND_API_KEY=re_yourResendApiKey
NOTIFICATION_FROM_EMAIL=alerts@vizagstartupmap.com

# -----------------------------------------------------------------
# 5. Cloudinary (logo uploads — free plan)
#    https://cloudinary.com → Dashboard
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# 6. App URL & Environment
# -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------
# 7. Map Tile Provider
#    Default uses OpenStreetMap raster tiles (free, attribution required).
# -----------------------------------------------------------------
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
